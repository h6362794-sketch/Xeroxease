# XeroxEase environment variables - placeholders only. Never commit real credentials.
# Copy this file to .env.local and fill in your own values.

# --- Database (Supabase PostgreSQL) ---
# Get the connection string from Supabase Dashboard > Project Settings > Database
# Use the "Connection Pooling" (pgbouncer, port 6543) string for serverless deployments,
# or the direct (port 5432) string for migrations.
DATABASE_URL="postgresql://postgres:YOUR_PASSWORD@db.YOUR_PROJECT_REF.supabase.co:5432/postgres"
DIRECT_URL="postgresql://postgres:YOUR_PASSWORD@db.YOUR_PROJECT_REF.supabase.co:5432/postgres"

# --- Supabase (optional, for Supabase Storage backend) ---
NEXT_PUBLIC_SUPABASE_URL="https://YOUR_PROJECT_REF.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="your-anon-key-here"
# SERVICE ROLE KEY MUST NEVER be exposed to the browser. Server-only.
SUPABASE_SERVICE_ROLE_KEY="your-service-role-key-here"

# --- Auth / Session ---
# Generate with: openssl rand -base64 32
SESSION_SECRET="generate-a-long-random-secret-at-least-32-chars"
SESSION_TTL_HOURS="24"

# --- App ---
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NODE_ENV="development"

# --- Storage backend: local private dir | supabase ---
STORAGE_BACKEND="local"
LOCAL_STORAGE_DIR=".data/uploads"

# --- Feature flags ---
ENABLE_OTP_VERIFICATION="false"
ENABLE_2FA="false"
ENABLE_EMAIL_DELIVERY="false"
ENABLE_MALWARE_SCAN="false"

# --- Rate limiting (upstash redis optional; in-memory fallback used otherwise) ---
RATE_LIMIT_STORAGE="memory"

# --- AI document analysis provider (optional) ---
AI_DOCS_PROVIDER="builtin"
AI_DOCS_API_KEY=""
