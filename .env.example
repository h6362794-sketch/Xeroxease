# XeroxEase environment variables - placeholders only. Never commit real credentials.
# Copy this file to .env.local and fill in your own values.
#
# Required vs optional is enforced by `npm run config:check`.

# --- Database (Supabase PostgreSQL) ---
# Get the connection string from Supabase Dashboard > Project Settings > Database
# Use the "Connection Pooling" (pgbouncer, port 6543) string for serverless deployments,
# or the direct (port 5432) string for migrations.
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE
DATABASE_URL="postgresql://postgres:YOUR_PASSWORD@db.YOUR_PROJECT_REF.supabase.co:5432/postgres"
DIRECT_URL="postgresql://postgres:YOUR_PASSWORD@db.YOUR_PROJECT_REF.supabase.co:5432/postgres"

# --- Supabase (required only when STORAGE_BACKEND=supabase) ---
NEXT_PUBLIC_SUPABASE_URL="https://YOUR_PROJECT_REF.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="your-anon-key-here"
# SERVICE ROLE KEY MUST NEVER be exposed to the browser. Server-only.
SUPABASE_SERVICE_ROLE_KEY="your-service-role-key-here"

# --- Storage backend: local (development) | supabase (production) ---
# local  -> private directory on the server disk (see LOCAL_STORAGE_DIR).
#           Refused in production unless ALLOW_EPHEMERAL_LOCAL_STORAGE=true, because
#           ephemeral/serverless filesystems lose uploaded documents on redeploy.
# supabase -> private Supabase Storage bucket named by STORAGE_BUCKET.
STORAGE_BACKEND="local"
STORAGE_BUCKET="documents"
LOCAL_STORAGE_DIR=".data/uploads"
# Set to true ONLY if you accept that uploaded documents may be lost on redeploy.
ALLOW_EPHEMERAL_LOCAL_STORAGE="false"

# --- Auth / Session ---
# Generate with: openssl rand -base64 32  (minimum 32 characters)
SESSION_SECRET="generate-a-long-random-secret-at-least-32-chars"
SESSION_TTL_HOURS="24"

# --- App ---
# Used to build absolute links (password reset). Must be an https URL in production.
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NODE_ENV="development"

# --- Email delivery (password reset links) ---
# Disabled by default. When disabled, reset links are not emailed; in development
# they can be surfaced in the API response by setting EXPOSE_RESET_TOKEN_IN_DEV=true.
# Supported: any Resend-compatible HTTPS API (POST {from,to,subject,text,html}).
ENABLE_EMAIL_DELIVERY="false"
EMAIL_API_URL=""
EMAIL_API_KEY=""
EMAIL_FROM=""
# Development only. Never enable in production.
EXPOSE_RESET_TOKEN_IN_DEV="false"

# --- Rate limiting ---
# memory -> single instance / development only.
# redis  -> shared counters across instances (recommended for production).
RATE_LIMIT_STORAGE="memory"
UPSTASH_REDIS_REST_URL=""
UPSTASH_REDIS_REST_TOKEN=""
# Fail closed (block requests) when the shared store is unreachable. Set to true to
# fail open instead, which disables protection during a store outage.
RATE_LIMIT_FAIL_OPEN="false"

# --- Feature flags ---
ENABLE_OTP_VERIFICATION="false"
ENABLE_2FA="false"
ENABLE_MALWARE_SCAN="false"

# --- AI document analysis provider (optional; "builtin" parsers are used otherwise) ---
AI_DOCS_PROVIDER="builtin"
AI_DOCS_API_KEY=""

# --- Seeding (npm run db:seed) ---
# Development only. In production the seed refuses to use default passwords; supply
# strong unique values here or create admins through the Super Admin console.
# SEED_STUDENT_PASSWORD=""
# SEED_ADMIN_PASSWORD=""
# ALLOW_DEV_SEED="false"
