# XeroxEase environment variables - placeholders only. Never commit real credentials.
# Copy this file to .env.local and fill in your own values.
#
# Required vs optional is enforced by `npm run config:check`.

# --- Database (Supabase PostgreSQL) ---
# Get the connection string from Supabase Dashboard > Project Settings > Database
#
# DATABASE_URL (runtime): the connection pooler (port 6543, transaction
#   mode) is recommended for serverless deployments. Current Supabase
#   poolers (Supavisor / PgBouncer >= 1.21) support Prisma's prepared
#   statements natively — do NOT append ?pgbouncer=true (it is only
#   needed for pre-1.21 poolers and can itself cause
#   `prepared statement "PGBOUNCER_..." does not exist`), and leave
#   connection_limit unset unless your platform imposes it: the app
#   keeps one singleton Prisma client, so connection_limit=1 would
#   serialise every query.
# DIRECT_URL (migrations): the direct connection (port 5432).
#   `prisma migrate deploy` needs it; transaction pooling breaks
#   migration/advisory locks.
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE
# The app validates both at startup and prints sanitised diagnostics
# (never the URL or password) via `npm run config:check`.
DATABASE_URL="postgresql://postgres:YOUR_PASSWORD@db.YOUR_PROJECT_REF.supabase.co:5432/postgres"
DIRECT_URL="postgresql://postgres:YOUR_PASSWORD@db.YOUR_PROJECT_REF.supabase.co:5432/postgres"

# --- Supabase (required when STORAGE_BACKEND=supabase) ---
# The app talks to Supabase Storage over its raw REST API (src/server/storage.ts),
# so only the project URL and the service-role key are needed.
NEXT_PUBLIC_SUPABASE_URL="https://YOUR_PROJECT_REF.supabase.co"
# NOT READ BY THIS APPLICATION. There is no Supabase Auth/RLS usage, so the anon key
# is deliberately unnecessary. It is kept here only so existing deployments do not
# break; do not treat its presence as evidence that the browser talks to Supabase.
NEXT_PUBLIC_SUPABASE_ANON_KEY=""
# SERVICE ROLE KEY MUST NEVER be exposed to the browser, a log line, an error message
# or a client-visible response. Server-only. It is used for: uploads that the app
# performs itself, object metadata/signature verification, and for minting the
# short-lived signed URLs handed to the browser for direct upload/download.
SUPABASE_SERVICE_ROLE_KEY="your-service-role-key-here"

# --- Storage backend: local (development) | supabase (production) ---
# local  -> private directory on the server disk (see LOCAL_STORAGE_DIR).
#           Refused in production unless ALLOW_EPHEMERAL_LOCAL_STORAGE=true, because
#           ephemeral/serverless filesystems lose uploaded documents on redeploy.
#           It also cannot do direct uploads (see the section below).
# supabase -> private Supabase Storage bucket named by STORAGE_BUCKET. The bucket MUST
#           stay private: the app never uses public object URLs.
STORAGE_BACKEND="local"
STORAGE_BUCKET="documents"
LOCAL_STORAGE_DIR=".data/uploads"
# Set to true ONLY if you accept that uploaded documents may be lost on redeploy.
# On Vercel there is no writable durable filesystem at all, so this is not a workaround.
ALLOW_EPHEMERAL_LOCAL_STORAGE="false"

# --- Direct-to-private-storage uploads (required for large files on Vercel) ---
# How document bytes move:
#   browser -> Supabase Storage (signed, single-path, time-limited URL), with the app
#   only authorizing the upload and then verifying what storage actually holds. This is
#   the ONLY mode that can carry a 50 MB file on a host that caps function request
#   bodies at 4.5 MB (Vercel). Requires STORAGE_BACKEND=supabase.
# The legacy proxy path (browser -> app -> storage) still exists for local development
# and for the small payment-QR image, but it is bounded by the platform's body limit.
# Kill switch: set to false to make every direct-upload endpoint return 503 so clients
# fall back to the proxy path. Only do that where files fit the platform body limit.
DIRECT_UPLOADS_ENABLED="true"
# How long a signed upload stays completable (60-3600 s, default 600).
UPLOAD_INTENT_TTL_SECONDS="600"
# Lifetime of the short-lived signed download URLs (10-900 s, default 60).
SIGNED_DOWNLOAD_URL_TTL_SECONDS="60"
# The storage provider's own per-file cap, if lower than the app's 50 MiB limit.
# Supabase FREE enforces a global 50 MB per-file limit that no application code can
# raise. For Free-tier deployments, mirror the provider value here. 0/unset = the
# application limit (50 MiB) is the binding one.
STORAGE_PROVIDER_MAX_FILE_BYTES="52428800"

# --- Auth / Session ---
# Generate with: openssl rand -base64 32  (minimum 32 characters)
SESSION_SECRET="generate-a-long-random-secret-at-least-32-chars"
SESSION_TTL_HOURS="24"

# --- Scheduled upload cleanup ---
# Bearer secret for POST /api/admin/uploads/sweep (retention and abandoned uploads).
# Optional locally; set it in production and give the same value to the scheduler.
# Generate with: openssl rand -base64 32  (minimum 32 characters)
# CRON_SECRET="generate-a-long-random-secret-at-least-32-chars"

# --- App ---
# Used for canonical URLs / OpenGraph / sitemap. Must be an https URL in production.
# NOTE: `NEXT_PUBLIC_*` is inlined at BUILD time on this side too, so changing the
# deployed URL requires a rebuild, not just a restart.
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NODE_ENV="development"
# Number of trusted reverse-proxy hops in front of the app, used to pick the client IP
# out of X-Forwarded-For for rate limiting and audit logs (src/server/api-utils.ts).
# 1 = one proxy (Vercel, nginx, Cloudflare). 0 = app directly exposed (XFF ignored,
# because the client could otherwise forge its own rate-limit bucket). NOT optional:
# the default is 1, which is wrong for a directly-exposed host and unsafe if you add a
# CDN without updating this.
TRUSTED_PROXY_COUNT="1"

# --- Account recovery ---
# Password recovery is EMAIL-FREE and requires no paid third-party service.
# Users self-generate a single-use 160-bit recovery code (Profile > Security) and
# redeem it with their identifier at /forgot-password.
#
# If a user loses their password without a code, a Super Admin issues them one from
# Admin > Users after verifying their identity in person. Codes issued that way
# expire in 24 hours (ADMIN_ISSUED_CODE_TTL_HOURS in src/server/recovery.ts).
#
# There is deliberately no EMAIL_* / SMTP / SMS configuration. Do not add one
# without also adding the corresponding provider integration.

# --- Rate limiting ---
# memory -> single instance / development only.
# redis  -> shared counters across instances (recommended for production).
RATE_LIMIT_STORAGE="memory"
UPSTASH_REDIS_REST_URL=""
UPSTASH_REDIS_REST_TOKEN=""
# Fail closed (block requests) when the shared store is unreachable. Set to true to
# fail open instead, which disables protection during a store outage.
RATE_LIMIT_FAIL_OPEN="false"

# --- Feature flags: NOT IMPLEMENTED. They are read by nothing in src/. ---
# They remain listed only so that an operator who set them previously does not think a
# control was removed. Setting them true grants no behaviour and must never be recorded
# as a mitigation. See SECURITY.md (2FA/OTP and malware scanning are not implemented).
ENABLE_OTP_VERIFICATION="false"
ENABLE_2FA="false"
ENABLE_MALWARE_SCAN="false"

# --- Not wired to any code (kept for documentation/history only) ---
# Document analysis is always the built-in parsers in src/server/doc-analysis.ts
# (pdf-lib for PDF, zlib inflate for .docx). There is no pluggable AI provider, so
# setting these has no effect and provisioning a key for them would be a mistake.
AI_DOCS_PROVIDER="builtin"
AI_DOCS_API_KEY=""

# --- Seeding (npm run db:seed) ---
# Development only. In production the seed refuses to use default passwords; supply
# strong unique values here or create admins through the Super Admin console.
# SEED_STUDENT_PASSWORD=""
# SEED_ADMIN_PASSWORD=""
# ALLOW_DEV_SEED="false"
